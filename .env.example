# Hotels Price Tracker Configurations

# --- Scraper Settings ---
# Optional: Path to the Chrome for Testing binary for Selenium.
CHROME_BINARY=

# Whether the scraper should run in headless mode.
# Defaults to True in Docker, False locally.
HEADLESS=True

# --- Search Settings ---
# These override defaults in src/config.py if provided
CITY=Taubate
DAYS_AHEAD=31
# Comma-separated list of hotels to track
HOTEL_COMPETITORS=Faro Hotel Taubaté,Ibis Taubate

# --- Email Notifications ---
EMAIL_SEND_FROM=your_email@gmail.com
EMAIL_SEND_FROM_PASSWORD=your_app_password
EMAIL_SEND_TO=destination_email@gmail.com

# --- Database ---
# Leave blank to use SQLite (local file, no server needed) — default for local development.
# Set to a PostgreSQL connection string to use a shared/live database.
#
# Format: postgresql://username:password@host:5432/database_name
#
# Examples:
#   Local Postgres via Postgres.app:  postgresql://localhost/hotels_db
#   Cloud Postgres (Supabase/Neon):   postgresql://user:pass@db.supabase.co:5432/hotels_db
#   Docker Compose Postgres:          postgresql://postgres:postgres@db:5432/hotels_db
#
# When switching to PostgreSQL, also:
#   1. Uncomment psycopg2-binary in requirements.txt
#   2. Run: pip install psycopg2-binary
DATABASE_URL=
